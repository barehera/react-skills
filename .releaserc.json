{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "docs", "release": "patch" },
          { "type": "refactor", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features", "hidden": false },
            { "type": "fix", "section": "Fixes", "hidden": false },
            {
              "type": "docs",
              "section": "Documentation",
              "hidden": false
            },
            {
              "type": "refactor",
              "section": "Refactoring",
              "hidden": false
            },
            {
              "type": "perf",
              "section": "Performance",
              "hidden": false
            },
            {
              "type": "build",
              "section": "Build system",
              "hidden": false
            },
            {
              "type": "ci",
              "section": "Continuous integration",
              "hidden": false
            },
            {
              "type": "test",
              "section": "Tests",
              "hidden": false
            },
            {
              "type": "chore",
              "section": "Maintenance",
              "hidden": false
            },
            { "type": "revert", "section": "Reverts", "hidden": false }
          ]
        },
        "writerOpts": {
          "headerPartial": "\n",
          "commitsSort": ["scope", "subject"]
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run release:sync-version -- ${nextRelease.version} && npm run validate"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "VERSION",
          "package.json",
          "package-lock.json"
        ],
        "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "releaseNameTemplate": "v<%= nextRelease.version %>",
        "releaseBodyTemplate": "A growing catalog of maintainable Agent Skills for React development.\n\n### Choose and install\n\n```bash\nnpx --yes git+ssh://git@react-skills/barehera/react-skills.git\n```\n\nRun it from a project root; it always installs the latest release. Add `update` to update an existing install, or a skill name to install one skill. See the README for private access.\n\n### Changes\n\n<%= nextRelease.notes.trim() || 'No user-facing changes were recorded for this release.' %>\n\n### Registry assets\n\nThe attached JSON files are the built catalog and skill items for this exact release.\n\n<% if (lastRelease.gitTag) { %>### Compare\n\n[View all changes from <%= lastRelease.gitTag %> to <%= nextRelease.gitTag %>](https://github.com/barehera/react-skills/compare/<%= lastRelease.gitTag %>...<%= nextRelease.gitTag %>)\n<% } %>",
        "assets": [
          {
            "path": "public/r/*.json",
            "label": "Built React Skills registry"
          }
        ]
      }
    ]
  ]
}
