        {
          "path": "agents/openai.yaml",
          "type": "registry:file",
          "target": "~/.agents/skills/debug-from-root-cause/agents/openai.yaml"
        }
      ],
      "docs": "Installs the root-cause debugging skill. No hooks, scripts, or session-start text."
