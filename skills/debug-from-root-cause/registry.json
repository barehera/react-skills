{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "debug-from-root-cause",
      "type": "registry:item",
      "title": "Debug from Root Cause",
      "description": "Find the mechanism behind a bug, fix it in the owning layer, and lock it with a regression test.",
