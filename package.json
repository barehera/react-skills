{
  "name": "react-skills",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "A growing catalog of maintainable Agent Skills for React development.",
  "homepage": "https://github.com/barehera/react-skills",
  "repository": "github:barehera/react-skills",
  "bin": {
    "react-skills": "./bin/react-skills.mjs"
  },
  "files": [
    "bin",
    "VERSION",
    "registry.json",
    "skills/*/registry.json"
  ],
  "scripts": {
    "registry:build": "shadcn build",
    "release:sync-version": "node scripts/sync-release-version.mjs",
    "shadcn": "shadcn",
    "release": "semantic-release",
    "skills:list": "node bin/react-skills.mjs --list",
    "typecheck:examples": "tsc --project tsconfig.examples.json",
    "validate": "node scripts/validate-registry.mjs && npm run skills:list && npm run typecheck:examples && npm run registry:build"
  },
  "devDependencies": {
    "@lukemorales/query-key-factory": "^1.3.4",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19.2.17",
    "axios": "^1.18.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "react": "^19.2.8",
    "semantic-release": "^25.0.8",
    "shadcn": "^4.13.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  }
}
