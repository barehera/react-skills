{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./skills/manage-server-state/examples/feature-colocated/src/*",
        "./skills/build-forms/examples/typed-feature-form/src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "skills/manage-server-state/examples/feature-colocated/src/**/*.ts",
    "skills/manage-server-state/examples/feature-colocated/src/**/*.tsx",
    "skills/build-forms/examples/typed-feature-form/src/**/*.ts",
    "skills/build-forms/examples/typed-feature-form/src/**/*.tsx"
  ]
}
